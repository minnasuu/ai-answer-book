# 生产环境配置示例
# 复制此文件为 .env.production 并根据实际情况修改

# 直接使用混元API绝对地址
VITE_HUNYUAN_API_URL=https://hunyuanapi.woa.com/openapi/v1/chat/completions

# 如果需要使用代理服务器（解决CORS问题）：
# VITE_HUNYUAN_API_URL=http://your-server-ip:3001/api/openapi/v1/chat/completions

# 如果需要HTTP（某些环境可能需要）：
# VITE_HUNYUAN_API_URL=http://hunyuanapi.woa.com/openapi/v1/chat/completions

# API Key（建议使用环境变量管理）
VITE_HUNYUAN_API_KEY=e9f263c8-b1b7-449e-81bb-30dac102e4be

# 模型名称
VITE_HUNYUAN_MODEL=hunyuan-turbos-latest

# 构建模式
NODE_ENV=production